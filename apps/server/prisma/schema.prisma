// Cloud backend schema (Postgres via Supabase or any managed Postgres).
// This is the source of truth once synced; the desktop app's local SQLite
// mirrors the same logical shape (see apps/desktop/src/db/schema.sql) but is
// generated/maintained by hand there since better-sqlite3 doesn't use Prisma.
//
// Design decisions baked into this schema (see /docs/DECISIONS.md for the
// full Q&A this was built from):
//  - pricing_rules is versioned (effective_from/effective_to) so historical
//    reports always reflect the price that applied when a game was played.
//  - Discounts are unrestricted (any staff, any amount) — no approval table.
//  - collateral_items tracks returned_at/returned for return tracking.
//  - shifts doubles as both "cash reconciliation / Z-report" AND staff
//    clock-in/clock-out attendance tracking — logout closes the shift and
//    closing the shift logs the user out (enforced in the app layer).
//  - payments.method captures cash/easypaisa/jazzcash/card for reconciliation.
//  - expenses is a lightweight ledger (not a canteen/inventory POS) capturing
//    money paid out of the drawer, by method, with a note.
//  - No table "maintenance" status, no reservations, no peak/weekend pricing,
//    no receipt printing, no refunds table (reversal + recreate instead), no
//    branch_id (multi-branch explicitly out of scope).
//  - customers.is_temporary ("nishani") records are intentionally NOT meant
//    to persist forever: a background job purges any nishani customer once
//    all of their linked games are fully paid and they were never merged
//    into a real customer (see apps/server/src/jobs/purgeNishani.ts). Because
//    that purge is a genuine hard delete of a row that historical, already
//    -settled games/payments/collateral may still point to, the FKs from
//    Game.loserCustomerId/winnerCustomerId, Payment.customerId and
//    CollateralItem.customerId to Customer are nullable with
//    onDelete: SetNull (fixed here vs. the original draft, which had
//    loserCustomerId/Payment.customerId/CollateralItem.customerId as
//    required — that would make decision #17's hard-delete-after-fully-paid
//    behavior impossible without a Postgres FK violation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  manager
  receptionist
}

enum TableType {
  standard
  private_room
}

enum TableStatusValue {
  occupied
  vacant
}

enum PaymentStatus {
  paid
  pending
  loan
  collateral
  tricked
}

enum PaymentMethod {
  cash
  easypaisa
  jazzcash
  card
}

model User {
  id               Int      @id @default(autoincrement())
  fullName         String
  username         String   @unique
  role             Role
  pinHash          String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  createdPricingRules  PricingRule[]      @relation("PricingRuleCreatedBy")
  gamesCreated         Game[]             @relation("GameCreatedBy")
  gamesDiscountedBy    Game[]             @relation("GameDiscountBy")
  gamesReversedBy      Game[]             @relation("GameReversedBy")
  paymentsCollected    Payment[]          @relation("PaymentCollectedBy")
  collateralHeldBy     CollateralItem[]   @relation("CollateralHeldBy")
  collateralReturnedBy CollateralItem[]   @relation("CollateralReturnedBy")
  shifts               Shift[]           @relation("ShiftUser")
  shiftsClosedByMe      Shift[]          @relation("ShiftClosedBy")
  expensesRecorded     Expense[]          @relation("ExpenseRecordedBy")
  expensesEdited       Expense[]          @relation("ExpenseEditedBy")
  auditEntries         AuditLog[]         @relation("AuditPerformedBy")
  capitalBalancesSet   CapitalStartingBalance[] @relation("CapitalStartingBalanceSetBy")
  payoutsPerformed     Payout[]           @relation("PayoutPerformedBy")

  @@map("users")
}

model Table {
  id          Int       @id @default(autoincrement())
  tableNumber Int       @unique
  tableType   TableType
  label       String
  isActive    Boolean   @default(true)

  games            Game[]
  tableStatusLogs  TableStatusLog[]

  @@map("tables")
}

model GameType {
  id                     Int    @id @default(autoincrement())
  code                   String @unique // '6_ball' | '6_ball_double' | 'full_frame' | 'full_frame_double' | 'century'
  name                   String
  defaultDurationMinutes Int
  isActive               Boolean @default(true)

  pricingRules PricingRule[]
  games        Game[]

  @@map("game_types")
}

// Versioned pricing: owner can change prices at any time (no peak/weekend
// pricing tiers). Old rows are closed via effectiveTo, never edited in place,
// so a game always resolves to the rule that was active at its start_time.
model PricingRule {
  id              Int       @id @default(autoincrement())
  tableType       TableType
  gameTypeId      Int
  gameType        GameType  @relation(fields: [gameTypeId], references: [id])
  price           Int
  durationMinutes Int
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime? // null = currently active
  createdById     Int
  createdBy       User      @relation("PricingRuleCreatedBy", fields: [createdById], references: [id])

  @@index([tableType, gameTypeId, effectiveFrom])
  @@map("pricing_rules")
}

// Customers, including temporary "nishani" placeholders. Nishani rows are
// intentionally ephemeral (see purgeNishani job) — they exist only so an
// unnamed customer's running dues can be tracked durably until settled.
model Customer {
  id                   Int       @id @default(autoincrement())
  displayName          String
  isTemporary          Boolean   @default(false)
  nishaniDescription   String?
  mergedIntoCustomerId Int?
  mergedInto           Customer? @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id])
  mergedFrom           Customer[] @relation("CustomerMerge")
  phone                String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  gamesAsLoser  Game[]           @relation("GameLoser")
  gamesAsWinner Game[]           @relation("GameWinner")
  payments      Payment[]
  collateral    CollateralItem[]

  @@index([displayName])
  @@map("customers")
}

model Shift {
  id                  Int       @id @default(autoincrement())
  userId              Int
  user                User      @relation("ShiftUser", fields: [userId], references: [id])
  openedAt            DateTime  @default(now())
  closedAt            DateTime?
  declaredCashAmount  Int?
  systemCashTotal     Int?
  cashVariance        Int?
  isLocked            Boolean   @default(false)
  closedById          Int?
  closedBy            User?     @relation("ShiftClosedBy", fields: [closedById], references: [id])

  games    Game[]
  payments Payment[]
  expenses Expense[]

  @@map("shifts")
}

model Game {
  id                       Int           @id @default(autoincrement())
  localUuid                String        @unique
  tableId                  Int
  table                    Table         @relation(fields: [tableId], references: [id])
  gameTypeId               Int
  gameType                 GameType      @relation(fields: [gameTypeId], references: [id])
  startTime                DateTime
  endTime                  DateTime?
  durationActualMinutes    Float?
  durationBilledMinutes    Int?
  priceOriginal            Int
  discountAmount           Int           @default(0)
  discountReason           String?
  discountById             Int?
  discountBy               User?         @relation("GameDiscountBy", fields: [discountById], references: [id])
  priceFinal               Int
  // Nullable + onDelete: SetNull (not a design default — see note above the
  // Customer model): decision #17 requires the nishani purge job to
  // hard-delete a temporary customer even though it may still be referenced
  // by fully-paid historical games. Postgres needs a nullable FK with
  // ON DELETE SET NULL to do that without violating referential integrity;
  // a NOT NULL loserCustomerId would make the documented purge behavior
  // impossible to implement. The purge job only ever deletes a customer
  // with zero pending/loan/collateral games, so in practice this only ever
  // goes null on already-settled (paid) rows, never live debt.
  loserCustomerId          Int?
  loserCustomer            Customer?     @relation("GameLoser", fields: [loserCustomerId], references: [id], onDelete: SetNull)
  winnerCustomerId         Int?
  winnerCustomer           Customer?     @relation("GameWinner", fields: [winnerCustomerId], references: [id], onDelete: SetNull)
  paymentStatus            PaymentStatus
  createdByUserId          Int
  createdBy                User          @relation("GameCreatedBy", fields: [createdByUserId], references: [id])
  shiftId                  Int
  shift                    Shift         @relation(fields: [shiftId], references: [id])
  reversed                 Boolean       @default(false)
  reversedById             Int?
  reversedBy               User?         @relation("GameReversedBy", fields: [reversedById], references: [id])
  reversedReason           String?
  reversedAt               DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  paymentLinks    PaymentGameLink[]
  collateralItems CollateralItem[]

  @@index([loserCustomerId, paymentStatus])
  @@index([tableId, startTime])
  @@map("games")
}

model Payment {
  id                 Int       @id @default(autoincrement())
  // Nullable + onDelete: SetNull for the same reason as Game.loserCustomerId
  // above — a nishani may have paid off their tab (payment recorded against
  // their temporary customer row) before the purge job hard-deletes them.
  customerId         Int?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount             Int
  method             PaymentMethod
  note               String?
  paidAt             DateTime  @default(now())
  collectedByUserId  Int
  collectedBy        User      @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id])
  shiftId            Int
  shift              Shift     @relation(fields: [shiftId], references: [id])

  gameLinks PaymentGameLink[]

  @@map("payments")
}

// Many-to-many: one payment can settle several rounds at once (losing chain).
model PaymentGameLink {
  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])
  gameId    Int
  game      Game    @relation(fields: [gameId], references: [id])

  @@id([paymentId, gameId])
  @@map("payment_game_links")
}

model CollateralItem {
  id               Int       @id @default(autoincrement())
  gameId           Int
  game             Game      @relation(fields: [gameId], references: [id])
  // Nullable + onDelete: SetNull — same nishani-purge reasoning as above.
  customerId       Int?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  itemDescription  String
  heldByUserId     Int
  heldBy           User      @relation("CollateralHeldBy", fields: [heldByUserId], references: [id])
  heldAt           DateTime  @default(now())
  returned         Boolean   @default(false)
  returnedAt       DateTime?
  returnedByUserId Int?
  returnedBy       User?     @relation("CollateralReturnedBy", fields: [returnedByUserId], references: [id])

  @@map("collateral_items")
}

// Vacancy tracking (§2.7). Status is only ever 'occupied' | 'vacant' — no
// "maintenance" state, per owner decision.
model TableStatusLog {
  id         Int               @id @default(autoincrement())
  tableId    Int
  table      Table             @relation(fields: [tableId], references: [id])
  status     TableStatusValue
  statusFrom DateTime
  statusTo   DateTime?

  @@index([tableId, statusFrom])
  @@map("table_status_log")
}

// Expense ledger: money paid out of the drawer (canteen restock, cue repair,
// etc.), by method, with a free-text note — a lightweight substitute for a
// full canteen/inventory POS module, which was explicitly out of scope.
model Expense {
  id               Int           @id @default(autoincrement())
  category         String
  amount           Int
  method           PaymentMethod
  note             String?
  spentAt          DateTime      @default(now())
  recordedByUserId Int
  recordedBy       User          @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id])
  shiftId          Int
  shift            Shift         @relation(fields: [shiftId], references: [id])
  // Any staff can correct an expense after the fact (same "unrestricted but
  // always attributed" philosophy as discounts, decision #3) — but every
  // edit is flagged here so the owner can spot a corrected entry at a
  // glance, on top of the full before/after already in audit_log.
  edited           Boolean       @default(false)
  editedAt         DateTime?
  editedById       Int?
  editedBy         User?         @relation("ExpenseEditedBy", fields: [editedById], references: [id])

  @@map("expenses")
}

// Owner-only balance sheet (spec extension): one row per payment method
// holding the ONE baseline amount the owner has physically/digitally on
// hand as of whenever they last set it. The current balance for a method
// is always computed as startingAmount + sum(payments) - sum(expenses) -
// sum(payouts) for that method — never stored as a running total, so it
// can't drift out of sync with the ledger it's derived from. Updating this
// (the owner correcting or topping up their recorded starting point) is
// itself just overwriting the one row per method, audited like everything
// else via audit_log.
model CapitalStartingBalance {
  method      PaymentMethod @id
  amount      Int
  updatedAt   DateTime      @updatedAt
  updatedById Int
  updatedBy   User          @relation("CapitalStartingBalanceSetBy", fields: [updatedById], references: [id])

  @@map("capital_starting_balances")
}

// Owner drawing money out of capital (e.g. taking profit out for personal
// use) — subtracts from that method's balance sheet total the same way an
// expense does, but tracked separately since it isn't a club operating cost.
model Payout {
  id               Int           @id @default(autoincrement())
  amount           Int
  method           PaymentMethod
  note             String?
  performedAt       DateTime      @default(now())
  performedById    Int
  performedBy      User          @relation("PayoutPerformedBy", fields: [performedById], references: [id])

  @@map("payouts")
}

// Append-only audit log. Nothing is ever hard-deleted; "delete" in the UI is
// always a soft-reverse recorded here with a full before/after snapshot.
model AuditLog {
  id            Int      @id @default(autoincrement())
  entityType    String
  entityId      Int
  action        String // 'create' | 'update' | 'reverse' | 'merge' | 'return_collateral' | 'shift_open' | 'shift_close'
  beforeValue   Json?
  afterValue    Json?
  performedById Int
  performedBy   User     @relation("AuditPerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedAt])
  @@map("audit_log")
}
