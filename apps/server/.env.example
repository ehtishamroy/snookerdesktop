# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string used by Prisma (and by the server at runtime).
# Example for a local Postgres: postgresql://postgres:postgres@localhost:5432/snooker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/snooker"

# Secret used to sign/verify JWTs. Use a long random string in production
# (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-string"

# How long an issued JWT stays valid. Any value accepted by the `ms` package
# (jsonwebtoken's `expiresIn`), e.g. "12h", "1d".
JWT_EXPIRES_IN="12h"

# Port the Express app listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the desktop app's dev server /
# owner-dashboard). Use "*" only for local development.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cron schedules (node-cron syntax). Defaults shown match src/index.ts.
NISHANI_PURGE_CRON="*/5 * * * *"
IDLE_ALERT_SCAN_CRON="*/1 * * * *"
